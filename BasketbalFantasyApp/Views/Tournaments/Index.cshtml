@model IEnumerable<BasketbalFantasyApp.Models.Tournament>
@{
    ViewData["Title"] = "League Tournament Brackets";
}

<div class="container dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="dashboard-title mb-1">League Tournament Brackets</h1>
            <p class="text-muted mb-0">Browse competitive tournaments, join schedules, or review statistics in tournament summaries.</p>
        </div>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success text-white">Schedule New Tournament</a>
    }
    <div class="row g-4">
        @foreach (var tournament in Model)
        {
            <div class="col-md-6">
                <div class="panel-block d-flex flex-column justify-content-between h-100">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="text-dark fw-bold mb-0">@tournament.TournamentName</h4>
                            <span class="badge bg-dark">@tournament.FormatType</span>
                        </div>
                        <p class="text-muted small mb-3">Event Date: <strong>@tournament.EventDate.ToString("MMMM dd, yyyy")</strong></p>
                        
                        <div class="mb-3">
                            <small class="text-muted d-block fw-bold mb-1">Enrolled Competing Teams (@tournament.TournamentTeams.Count):</small>
                            @if (!tournament.TournamentTeams.Any())
                            {
                                <span class="text-muted small italic">No franchises signed yet.</span>
                            }
                            else
                            {
                                @foreach (var team in tournament.TournamentTeams)
                                {
                                    <span class="badge bg-light text-dark border me-1">@team.Team?.TeamName</span>
                                }
                            }
                        </div>
                    </div>

                    <div class="border-top pt-3 mt-2 text-end d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Requires @tournament.RequiredWins Wins</span>
                        <div>
                            @if (tournament.IsCompleted)
                            {
                                <a asp-controller="TournamentGameplay" asp-action="Summary" asp-route-id="@tournament.TournamentId" class="btn btn-sm btn-outline-primary fw-bold">View Championship Summary</a>
                            }
                            else
                            {
                                <a asp-controller="TournamentGameplay" asp-action="RegisterTeam" asp-route-id="@tournament.TournamentId" class="btn btn-sm btn-warning text-dark fw-bold me-1">Register My Team</a>

                                @if (User.IsInRole("Admin") && tournament.TournamentTeams.Count >= 2)
                                {
                                    <a asp-controller="Games" asp-action="SimulateTournament" asp-route-id="@tournament.TournamentId" class="btn btn-sm btn-success text-white">Simulate Tournament</a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>