@model IEnumerable<BasketbalFantasyApp.Models.Tournament>
@{
    ViewData["Title"] = "League Tournaments Bracket";
}

<div class="container dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="dashboard-title mb-1">League Tournament Brackets</h1>
            <p class="text-muted mb-0">Public schedule for tracking tournament activities and event matches.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success text-white">Schedule New Bracket</a>
        }
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="text-center empty-notice">
                    <p class="mb-0 text-muted">No league brackets are currently scheduled. Check back later for upcoming tournament matchups.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var tournament in Model)
            {
                <div class="col-md-6">
                    <div class="panel-block d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="text-primary fw-bold mb-0">@tournament.TournamentName</h4>
                                <span class="badge bg-dark">@tournament.FormatType</span>
                            </div>
                            <p class="text-muted small mb-3">Event Date: <strong>@tournament.EventDate.ToString("MMMM dd, yyyy")</strong></p>
                        </div>
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="border-top pt-2 mt-3 text-end">
                                <a asp-action="Delete" asp-route-id="@tournament.TournamentId" class="btn btn-sm btn-outline-danger">Cancel Tournament</a>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>