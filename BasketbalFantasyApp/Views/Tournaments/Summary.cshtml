@model BasketbalFantasyApp.Models.TournamentSummaryViewModel
@{
    ViewData["Title"] = "Championship Summary";
}

<div class="container dashboard-container">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <span class="badge bg-success px-3 py-2 text-uppercase letter-spacing-1 mb-2">Tournament Concluded</span>
            <h1 class="dashboard-title mb-1">@Model.TournamentDetails.TournamentName</h1>
            <p class="text-muted">Official summary tracking tournament outcomes, rosters, and player valuations.</p>
        </div>
    </div>

    <!-- Championship Banner -->
    <div class="row mb-4 justify-content-center">
        <div class="col-md-10">
            <div class="crud-wrapper bg-warning text-dark text-center p-4 border shadow-sm">
                <h2 class="fw-bold mb-1"> Tournament Champions </h2>
                <h1 class="display-5 fw-bold mb-2">@Model.WinnerTeam.TeamName</h1>
                <p class="mb-0 text-muted text-uppercase fw-bold small">Corporate Partner: @Model.WinnerTeam.SponsorName</p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Roster Profiles of Winners -->
        <div class="col-lg-6">
            <div class="panel-block">
                <div class="panel-header"><span>Championship Winning Lineup</span></div>
                <div class="table-responsive">
                    <table class="table custom-table">
                        <thead>
                            <tr>
                                <th>Athlete</th>
                                <th>Position</th>
                                <th>NBA Team</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in Model.WinnerRoster)
                            {
                                <tr>
                                    <td><strong>@player.FirstName @player.LastName</strong></td>
                                    <td><span class="badge bg-dark">@player.Position</span></td>
                                    <td><span class="text-muted">@player.NbaTeam</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


    </div>

    
</div>