@model BasketbalFantasyApp.Models.Tournament
@{
    ViewData["Title"] = "Schedule New Tournament Bracket";
}

<div class="container dashboard-container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="dashboard-title mb-1">Schedule Tournament Bracket</h1>
            <p class="text-muted">Admin Panel: Establish public bracket constraints and league match configurations.</p>

            <div class="crud-wrapper">
                <form asp-action="Create" method="post">
                    


                    <div class="button-action-grid">
                        <button type="submit" class="btn btn-success text-white px-4">Publish Tournament Bracket</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Return to Schedules</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}