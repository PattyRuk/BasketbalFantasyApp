@model BasketbalFantasyApp.Models.Player
@{
    ViewData["Title"] = "Draft Athlete to Roster";
}

<div class="container dashboard-container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="dashboard-title mb-1">Draft a Player</h1>
            <p class="text-muted">Select an available athlete from the global pool to sign them to your franchise squad roster.</p>

            <div class="crud-wrapper">
                <form asp-action="Create" method="post">

                    <div class="form-group-custom shadow-sm p-3 mb-4 bg-light rounded border">
                        <label class="form-label-custom fs-5 mb-2 text-primary">Available Player Pool Selection</label>

                        <!-- Dropdown Player list options -->
                        <select name="selectedPlayerId" asp-items="ViewBag.PlayerDropdown" class="form-input-custom fs-6 py-2">
                            <option value="">-- Choose a Basketball Athlete to Sign --</option>
                        </select>
                    </div>

                    <div class="button-action-grid">
                        <button type="submit" class="btn btn-warning text-dark fw-bold px-4 shadow-sm">Sign Athlete to Team</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}