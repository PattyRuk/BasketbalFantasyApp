@model IEnumerable<BasketbalFantasyApp.Models.Tournament>
@{
    ViewData["Title"] = "League Tournaments Bracket";
}

<div class="container dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="dashboard-title mb-1">League Tournament Brackets</h1>
            <p class="text-muted mb-0">Public schedule for tracking tournament activities and event matches.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success text-white">Schedule New Bracket</a>
        }
    </div>

</div>