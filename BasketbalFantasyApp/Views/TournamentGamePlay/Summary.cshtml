@model BasketbalFantasyApp.Models.TournamentSummaryViewModel
@{
    ViewData["Title"] = "Championship Summary";
}

<div class="container dashboard-container">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <span class="badge bg-success px-3 py-2 text-uppercase letter-spacing-1 mb-2">Tournament Concluded</span>
            <h1 class="dashboard-title mb-1">@Model.TournamentDetails.TournamentName</h1>
            <p class="text-muted">A Summary of the tournament outcome, and player evaluations.</p>
        </div>
    </div>
    <div class="panel-header d-flex justify-content-between align-items-center">
        <span>Final Standings Leaderboard</span>
        <a asp-action="MatchLogs" asp-route-id="@Model.TournamentDetails.TournamentId" class="btn btn-sm btn-outline-dark">View Individual Match Logs</a>
    </div>
    <!-- Championship Banner -->
    <div class="row mb-4 justify-content-center">
        <div class="col-md-10">
            <div class="crud-wrapper bg-warning text-dark text-center p-4 border shadow-sm">
                <h2 class="fw-bold mb-1"> Tournament Champions </h2>
                <h1 class="display-5 fw-bold mb-2">@Model.WinnerTeam.TeamName</h1>
                <p class="mb-0 text-muted text-uppercase fw-bold small">Corporate Partner: @Model.WinnerTeam.SponsorName</p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Roster Profiles of Winners -->
        <div class="col-lg-6">
            <div class="panel-block">
                <div class="panel-header"><span>Championship Winning Lineup</span></div>
                <div class="table-responsive">
                    <table class="table custom-table">
                        <thead>
                            <tr>
                                <th>Athlete</th>
                                <th>Position</th>
                                <th>NBA Team</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in Model.WinnerRoster)
                            {
                                <tr>
                                    <td><strong>@player.FirstName @player.LastName</strong></td>
                                    <td><span class="badge bg-dark">@player.Position</span></td>
                                    <td><span class="text-muted">@player.NbaTeam</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tournament MVP Section -->
        <div class="col-lg-6">
            <div class="panel-block bg-dark text-white p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="border-bottom border-secondary pb-2 mb-3">
                        <span class="text-warning text-uppercase small fw-bold tracking-wide">Tournament MVP Award</span>
                    </div>
                    <h2 class="text-warning fw-bold mb-1">@Model.TournamentMvp.FirstName @Model.TournamentMvp.LastName</h2>
                    <p class="text-muted small mb-3">Representing: @Model.TournamentMvp.Team</p>
                </div>
                <div class="row bg-secondary bg-opacity-25 rounded p-3 text-center g-2">
                    <div class="col-6">
                        <div class="text-warning fs-3 fw-bold">@Model.MvpTotalPoints</div>
                        <small class="text-muted uppercase small">Total Points Scored</small>
                    </div>
                    <div class="col-6">
                        <div class="text-warning fs-3 fw-bold">@Model.MvpAveragePoints</div>
                        <small class="text-muted uppercase small">Points Per Game</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- General Leaderboard Standings -->
    <div class="row">
        <div class="col-12">
            <div class="panel-block">
                <div class="panel-header"><span>Tournament Standings Leaderboard</span></div>
                <div class="table-responsive">
                    <table class="table custom-table table-striped">
                        <thead>
                            <tr>
                                <th>Final Posistion</th>
                                <th>Managed Team</th>
                                <th class="text-center">Wins</th>
                                <th class="text-center">Losses</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rank in Model.Standings)
                            {
                                <tr>
                                    <td>
                                        <span class="badge @(rank.FinalPosition == "Champion" ? "bg-warning text-dark" : rank.FinalPosition == "Runner-Up" ? "bg-secondary" : "bg-light text-dark")">
                                            @rank.FinalPosition
                                        </span>
                                    </td>
                                    <td><strong>@rank.Team?.TeamName</strong></td>
                                    <td class="text-center text-success fw-bold">@rank.WinsCount</td>
                                    <td class="text-center text-danger">@rank.LossesCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-center mt-3 pt-3 border-top">
                    <a asp-controller="Tournaments" asp-action="Index" class="btn btn-outline-dark px-4">Return to Tournament Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>