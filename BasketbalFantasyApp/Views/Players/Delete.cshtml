@model BasketbalFantasyApp.Models.Player
@{
    ViewData["Title"] = "Drop Athlete Confirmation";
}

<div class="container dashboard-container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="dashboard-title text-danger mb-1">Drop Roster Profile</h1>
            <p class="text-muted">Confirm permanent deletion across fantasy league system.</p>

            <div class="crud-wrapper">
                <div class="danger-display-panel">
                    <h5 class="text-danger fw-bold mb-1">Warning: Permanent Action</h5>
                    <p class="mb-0 text-muted small">Deleting this player will destroy all linked statistics logged.</p>
                </div>

                <table class="table table-bordered mb-4">
                    <tr>
                        <th class="bg-light w-25 text-muted small fw-bold">Target Athlete Name</th>
                        <td><strong>@Model.FirstName @Model.LastName</strong></td>
                    </tr>
                    <tr>
                        <th class="bg-light text-muted small fw-bold">Assigned Position</th>
                        <td>@Model.Position</td>
                    </tr>
                    <tr>
                        <th class="bg-light text-muted small fw-bold">Current Assigned Roster</th>
                        <td>@Model.Team?.TeamName</td>
                    </tr>
                </table>

            </div>
        </div>
    </div>
</div>