@model IEnumerable<BasketbalFantasyApp.Models.Team>
@{
    ViewData["Title"] = "League Franchises";
}

<div class="container dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="dashboard-title mb-1">League Franchises</h1>
            <p class="text-muted mb-0">Browse existing basketball clubs and registered teams.</p>
        </div>
        
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-action="Create" class="btn btn-dark">Register New Franchise</a>
        }
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="text-center empty-notice">
                    <p class="mb-0 text-muted">No basketball franchise teams are currently registered inside the system.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var team in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="panel-block d-flex flex-column justify-content-between h-100">
                        <div>
                            <h3 class="text-dark fw-bold mb-1">@team.TeamName</h3>
                            <p class="text-muted small mb-2">Corporate Sponsor: <span class="badge bg-light text-dark border">@team.SponsorName</span></p>
                            
                            <p class="text-muted small mb-3">
                                Active Players Enrolled: <strong>@(team.Players?.Count ?? 0)</strong>
                            </p>
                        </div>

                        <!-- Administrative Control Panel Boundary Line -->
                        <div class="border-top pt-2 mt-2 text-end d-flex justify-content-between align-items-center">
                            <span class="text-muted small">ID: #@team.TeamId</span>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@team.TeamId" class="btn btn-sm btn-outline-danger">Drop Team</a>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">Verified</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>